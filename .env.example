# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Configuration
# Server-side (Render / Node.js)
SUPABASE_URL=https://dvebugolbpzgvczqjzxr.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Client-side (Vite / Browser)
VITE_SUPABASE_URL=https://dvebugolbpzgvczqjzxr.supabase.co
VITE_SUPABASE_ANON_KEY=

# Resend Transactional Email API (Server-side)
RESEND_API_KEY=
SENDER_EMAIL=support@versalbank.com
SUPPORT_EMAIL=support@versalbank.com
ADMIN_ALERT_EMAIL=contact@versalbank.com

# Backend API URL (for Render or custom deployment, optional when full-stack)
VITE_API_URL=
